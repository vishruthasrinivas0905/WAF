# Development server settings
PORT=3000
WAF_MODE=ENFORCING

# Optional: if omitted, /proxy/* returns a labeled mock demo response.
# Set to a trusted upstream origin to enable real proxying.
# UPSTREAM_URL=http://127.0.0.1:3001

# Required in production; generate a random secret with at least 32 characters.
# Never commit a real token. Compose requires this value at launch.
# WAF_ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Optional comma-separated IP/CIDR ranges for actual reverse proxies in front
# of this service. Leave empty unless these addresses are under your control.
# Do not set this to "true".
# WAF_TRUST_PROXY=loopback,10.0.0.0/8
